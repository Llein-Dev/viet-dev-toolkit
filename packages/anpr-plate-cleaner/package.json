{
  "name": "@llein/anpr-plate-cleaner",
  "version": "1.0.0",
  "description": "Production-grade OCR/ANPR license plate text cleaner, character confusion disambiguation (0/O, 1/I, 8/B), 2-line combiner, and fuzzy matcher.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Llein-Dev/viet-dev-toolkit.git",
    "directory": "packages/anpr-plate-cleaner"
  },
  "homepage": "https://github.com/Llein-Dev/viet-dev-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Llein-Dev/viet-dev-toolkit/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "publish": "npm publish --access public",
    "pub": "npm publish --access public",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "utility",
    "zero-dependency",
    "typescript",
    "anpr",
    "alpr",
    "ocr",
    "license-plate",
    "vietnam",
    "post-processing",
    "cleaner",
    "fuzzy-matching",
    "computer-vision"
  ],
  "author": "llein",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}