{
  "name": "@llein/vn-bank-qr-gen",
  "version": "1.1.0",
  "description": "Ultra-lightweight generator for VietQR (NAPAS 247) EMVCo payment payloads and quick-link QR URLs with React Hook useVietQR.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format cjs,esm --dts --clean --external react",
    "dev": "tsup src/index.ts src/react.ts --format cjs,esm --watch --dts --external react",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "utility",
    "zero-dependency",
    "typescript",
    "vietqr",
    "napas",
    "banking",
    "payment",
    "react-hook",
    "use-vietqr",
    "emvco",
    "vietnam"
  ],
  "author": "llein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Llein-Dev/viet-dev-toolkit.git",
    "directory": "packages/vn-bank-qr-gen"
  },
  "homepage": "https://github.com/Llein-Dev/viet-dev-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Llein-Dev/viet-dev-toolkit/issues"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
