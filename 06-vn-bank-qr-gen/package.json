{
  "name": "@llein/vn-bank-qr-gen",
  "version": "1.0.1",
  "description": "Ultra-lightweight generator for VietQR (NAPAS 247) EMVCo payment payloads and quick-link QR URLs.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "utility",
    "zero-dependency",
    "typescript",
    "vietqr",
    "napas",
    "banking",
    "payment",
    "emvco",
    "vietnam"
  ],
  "author": "llein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Llein-Dev/viet-dev-toolkit.git",
    "directory": "06-vn-bank-qr-gen"
  },
  "homepage": "https://github.com/Llein-Dev/viet-dev-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Llein-Dev/viet-dev-toolkit/issues"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}